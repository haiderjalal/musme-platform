# Copy to .env.local for local development. Never commit real values.

# Public site URL, used for auth redirects. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (public values, safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Vercel Cron sends this as the bearer token for /api/cron/expire-holds.
CRON_SECRET=
